# ── Backend de JOLUP ─────────────────────────────────────────────────────────
# URL pública del backend, sin barra final ni /api (el worker añade
# /internal/code-agent). Ej.: https://jolup-api.ycvrm9.easypanel.host
JOLUP_API_URL=
# Token compartido con el backend para la API interna del worker (mínimo 32
# caracteres). Debe ser el mismo valor que tenga configurado el backend.
CODE_AGENT_WORKER_TOKEN=

# ── GitHub ───────────────────────────────────────────────────────────────────
# PAT de grano fino (fine-grained) limitado SOLO a los repos conectados en
# JOLUP, con permisos «Contents: Read and write» y «Pull requests: Read and
# write». Lo usan git (clone/push) y la API de PRs; nunca llega a Claude.
GITHUB_TOKEN=

# ── Claude Code ──────────────────────────────────────────────────────────────
# Token OAuth de larga duración de la suscripción de Claude. Se obtiene en una
# máquina con sesión iniciada ejecutando `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Modelo para Claude Code (opcional; vacío = el que Claude use por defecto).
CLAUDE_MODEL=
# Máximo de turnos del agente por ejecución (opcional; vacío = sin tope).
CLAUDE_MAX_TURNS=

# ── Tiempos (milisegundos) ───────────────────────────────────────────────────
# Pausa entre consultas a la cola cuando está vacía o el backend falla (30 s).
POLL_INTERVAL_MS=30000
# Cada cuánto se renueva el bloqueo de la ejecución en curso (2 min; el
# bloqueo dura 20 min en el backend).
HEARTBEAT_INTERVAL_MS=120000
# Tiempo máximo que puede correr Claude Code en una ejecución (45 min).
RUN_TIMEOUT_MS=2700000

# ── Directorios e identidad de git ───────────────────────────────────────────
# Carpeta donde se crea un directorio temporal por ejecución (se borra al final).
WORK_DIR=/tmp/code-agent-runs
# Autor de los commits que hace el agente.
GIT_AUTHOR_NAME=JOLUP Agent
GIT_AUTHOR_EMAIL=agent@jpdev.com.co
